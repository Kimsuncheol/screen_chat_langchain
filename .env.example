# Server only. Copy to .env and keep it out of source control.
SC_OLLAMA_API_KEY=
# Obtain the exact direct-cloud name from https://ollama.com/api/tags.
# Official Cloud docs currently show gemma4:31b; do not use CLI-only :cloud aliases.
SC_MODEL_ID=
# Flutter currently uses this project; use a separate development project for testing.
SC_FIREBASE_PROJECT_ID=screenask-e4147
# Prefer workload identity/ADC in deployment. If needed, path to a private file OUTSIDE the repo.
# GOOGLE_APPLICATION_CREDENTIALS=/secure/location/service-account.json
SC_ENABLED_ACTIONS=["summarize","analyze","ask"]
# Enable only after verifying this exact cloud model accepts images and the budgets below.
SC_IMAGE_SUPPORT_VERIFIED=false
# Exact SC_MODEL_ID whose vision support was verified; a mismatch disables images.
SC_VERIFIED_IMAGE_MODEL_ID=
SC_CONTEXT_TOKENS=32768
SC_MAX_OUTPUT_TOKENS=2048
SC_IMAGE_TOKEN_RESERVE=8192
SC_MAX_REQUEST_BYTES=8388608
SC_MAX_IMAGE_BYTES=5242880
SC_MAX_IMAGE_PIXELS=16000000
SC_MAX_QUESTION_CHARACTERS=4000
SC_MAX_OCR_CHARACTERS=12000
SC_MAX_FOCUS_CHARACTERS=2000
SC_MAX_MESSAGES=12
SC_MAX_MESSAGE_CHARACTERS=4000
SC_MAX_TOTAL_TEXT_CHARACTERS=24000
SC_MAX_CONCURRENT_REQUESTS_PER_USER=1
SC_MAX_CONCURRENT_REQUESTS=8
SC_REQUESTS_PER_MINUTE=10
SC_REQUESTS_PER_DAY=100
SC_REQUEST_TIMEOUT_SECONDS=120
SC_BODY_TIMEOUT_SECONDS=15
SC_CONNECT_TIMEOUT_SECONDS=10
SC_UPSTREAM_IDLE_TIMEOUT_SECONDS=30
# Empty permits all verified users in the configured Firebase project.
SC_ALLOWED_UIDS=[]
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
